{
  "name": "@pixel-point/aval-svelte",
  "version": "1.0.1",
  "description": "Svelte bindings for interactive AVAL assets.",
  "keywords": [
    "animation",
    "svelte",
    "web-component",
    "motion"
  ],
  "private": false,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pixel-point/aval.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://github.com/pixel-point/aval",
  "bugs": {
    "url": "https://github.com/pixel-point/aval/issues"
  },
  "dependencies": {
    "@pixel-point/aval-element": "1.0.1"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "2.5.8",
    "svelte": "5.56.8",
    "svelte-check": "4.7.4",
    "typescript": "6.0.3"
  },
  "scripts": {
    "build": "svelte-package -i src -o dist --tsconfig tsconfig.json",
    "test:browser": "playwright test --config test/browser/playwright.config.ts",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  }
}
