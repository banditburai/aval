    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pixel-point/aval.git",
    "directory": "packages/graph"
  },
  "homepage": "https://github.com/pixel-point/aval",
  "bugs": {
    "url": "https://github.com/pixel-point/aval/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
