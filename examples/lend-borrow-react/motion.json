        "targetPort": "default",
        "maxWaitFrames": 35
      },
      "continuity": "exact-authored"
    },
    {
      "id": "active.idle",
      "from": "active",
      "to": "idle",
      "trigger": { "type": "completion" },
      "start": {
        "type": "finish",
        "targetPort": "default",
        "maxWaitFrames": 35
      },
      "continuity": "exact-authored"
    }
  ],
  "bindings": []
